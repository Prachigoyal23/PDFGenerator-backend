# ==========================================
# Backend Environment Configuration Example
# Copy this file to .env and replace secrets
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI with credentials)
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/pdf_generator?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pdf_generator

# Allowed CORS Origins (comma-separated or *)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security / JWT Secret Key (replace with strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Max Upload Size in MB
MAX_FILE_SIZE_MB=20

# Puppeteer Rendering Timeout (in ms)
PUPPETEER_TIMEOUT_MS=30000

# Optional: Custom Chromium executable path
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
